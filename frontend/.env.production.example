# AquaOps frontend — production environment template.
#
# Both variables default to the page's own origin, which is correct when the
# frontend is served from the same origin as the backend (e.g. the nginx
# reverse-proxy deploy under infrastructure/kubernetes|helm) — leave both
# commented out in that case. Set them only when the frontend and backend
# are deployed on different origins.
#
# These are the only VITE_ variables the frontend currently reads
# (src/lib/api.ts, src/hooks/useRealtime.ts).

# VITE_API_BASE_URL=https://REPLACE_API_DOMAIN/api/v1
# VITE_WS_BASE_URL=wss://REPLACE_API_DOMAIN
