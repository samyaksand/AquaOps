# AquaOps backend — production environment template.
#
# Copy to .env (or set these as real environment variables / secrets in your
# deployment platform) and replace every placeholder below. Do not commit a
# file containing real credentials.
#
# These are exactly the fields app/core/config.py's Settings reads (env
# lookup is case-insensitive) — no other variables are consulted.

# General
ENVIRONMENT=production
DEBUG=false

# Database — PostgreSQL + PostGIS. Use your managed/production instance;
# never the local docker-compose credentials.
#
# If using Supabase: use the DIRECT connection string (port 5432), not the
# Supavisor/pgbouncer transaction-pooler string (port 6543). asyncpg's
# server-side prepared statements are incompatible with transaction-mode
# pooling and will fail intermittently under concurrent load. The app's own
# SQLAlchemy engine already pools connections, so Supabase's pooler brings
# no benefit here. (The engine also sets statement_cache_size=0 as a
# belt-and-suspenders fix — see app/db/session.py — but the direct
# connection is still the recommended, simpler path.)
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB
DATABASE_ECHO=false

# CORS — the exact origin(s) the frontend is served from. Only needed when
# the frontend and backend are on different origins; a same-origin reverse
# proxy deploy (e.g. the nginx setup under infrastructure/) never hits CORS.
# Must be a JSON array string exactly like this, not a bare comma-separated
# list — pydantic-settings parses list[str] fields as JSON, so
# CORS_ORIGINS=https://a.com,https://b.com will fail to parse at startup.
CORS_ORIGINS=["https://REPLACE_FRONTEND_DOMAIN"]

# Redis — current-state cache and realtime pub/sub fanout.
REDIS_URL=redis://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:6379/0

# Kafka — event transport for allocation/scenario outcomes. Best-effort: the
# API keeps working even if this is unreachable. Set KAFKA_ENABLED=false to
# skip it entirely if no broker is deployed.
KAFKA_BOOTSTRAP_SERVERS=REPLACE_HOST:9092
KAFKA_ENABLED=true
